# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# (Dashboard -> Project Settings -> API)

# URL do projeto, ex.: https://abcdefgh.supabase.co
# (pode usar SUPABASE_URL ou NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=

# CHAVE SECRETA — service_role (clássica) OU secret key (nova, sb_secret_...).
# É usada só no servidor; NÃO prefixe com NEXT_PUBLIC_ e NÃO use a publishable/anon
# (com o RLS ativo, a publishable/anon não lê nem grava nada).
SUPABASE_SERVICE_ROLE_KEY=
